---
import { siteConfig } from "../config/site";

const {
  contactEmail,
  contactPhone,
  headOfficeAddress,
  manufacturingUnitAddress,
} = siteConfig;
---

<footer
  class="mt-4 bg-[var(--rk-dark)] py-12 text-white border-t border-white/5"
>
  <div class="section-shell">
    <div class="grid gap-12 lg:grid-cols-4 lg:gap-8">
      <!-- Brand & About -->
      <div class="lg:col-span-1">
        <div class="inline-flex mb-6">
          <img
            src="/images/logo/rk-granito-logo.jpeg"
            alt="RK Granito Logo"
            class="h-20 w-auto sm:h-24 md:h-32"
          />
        </div>
        <p class="text-sm leading-relaxed text-neutral-400">
          <span
            class="block text-[var(--rk-red)] font-bold uppercase tracking-widest text-[10px] mb-2 font-luxury"
            >Engineered for Elegant Living</span
          >
          RK Granito is a leading porcelain tile manufacturer and exporter delivering
          elegant surfaces worldwide. Building luxury into every space.
        </p>
      </div>

      <!-- Quick Links -->
      <div class="lg:ml-auto">
        <h4
          class="text-xs font-bold uppercase tracking-[0.25em] text-white underline underline-offset-8 decoration-[var(--rk-red)] mb-6"
        >
          Navigation
        </h4>
        <ul class="space-y-3 text-sm">
          <li>
            <a
              href="/"
              class="text-neutral-400 hover:text-[var(--rk-red)] transition-colors"
              >Home</a
            >
          </li>
          <li>
            <a
              href="/company"
              class="text-neutral-400 hover:text-[var(--rk-red)] transition-colors"
              >Company</a
            >
          </li>
          <li>
            <a
              href="/products"
              class="text-neutral-400 hover:text-[var(--rk-red)] transition-colors"
              >Products</a
            >
          </li>
          <li>
            <a
              href="/contact"
              class="text-neutral-400 hover:text-[var(--rk-red)] transition-colors"
              >Contact</a
            >
          </li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div class="lg:col-span-2 grid gap-8 sm:grid-cols-2 lg:gap-4">
        <div>
          <h4
            class="text-xs font-bold uppercase tracking-[0.25em] text-white border-l-2 border-[var(--rk-red)] pl-3 mb-6"
          >
            Contact Details
          </h4>
          <div class="space-y-4 text-sm text-neutral-400">
            <p class="flex items-center gap-2">
              <span class="text-[var(--rk-red)] text-xs">●</span>
              {contactEmail}
            </p>
            <p class="flex items-center gap-2">
              <span class="text-[var(--rk-red)] text-xs">●</span>
              {contactPhone}
            </p>
          </div>
        </div>

        <div>
          <h4
            class="text-xs font-bold uppercase tracking-[0.25em] text-white border-l-2 border-[var(--rk-red)] pl-3 mb-6"
          >
            Our Locations
          </h4>
          <div class="space-y-6 text-sm text-neutral-400">
            <div>
              <p class="text-[10px] uppercase font-bold text-neutral-500 mb-1">
                Head Office
              </p>
              <p
                class="leading-relaxed"
                set:html={headOfficeAddress?.replace(", ", ",<br />")}
              />
            </div>
            <div>
              <p class="text-[10px] uppercase font-bold text-neutral-500 mb-1">
                Manufacturing Unit
              </p>
              <p
                class="leading-relaxed"
                set:html={manufacturingUnitAddress?.replace(", ", ",<br />")}
              />
            </div>
          </div>
        </div>
      </div>
    </div>

    <div
      class="mt-16 pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4 text-[11px] tracking-widest text-neutral-500 uppercase"
    >
      <p>© {new Date().getFullYear()} RK Granito. All rights reserved.</p>
      <div class="flex gap-8">
        <a href="#" class="hover:text-white transition-colors">Privacy Policy</a
        >
        <a href="#" class="hover:text-white transition-colors"
          >Terms of Service</a
        >
      </div>
    </div>
  </div>
</footer>
