---
import { siteConfig } from "../config/site";

const {
  contactEmail,
  contactPhone,
  headOfficeAddress,
  manufacturingUnitAddress,
} = siteConfig;
---

<section class="section-shell py-20 sm:py-24">
  <div class="grid gap-8 lg:grid-cols-2">
    <div
      class="reveal rounded-2xl border border-neutral-300 bg-white p-6 shadow-[0_24px_52px_-36px_rgba(0,0,0,0.4)] sm:p-10"
    >
      <form id="contact-form" class="space-y-4" novalidate>
        <div class="relative">
          <input
            type="text"
            id="name"
            name="name"
            placeholder="Name *"
            required
            class="peer w-full rounded-lg border border-neutral-300 px-4 py-3.5 outline-none transition focus:border-[var(--rk-red)] focus:ring-1 focus:ring-[var(--rk-red)]/20"
          />
          <p class="mt-1 hidden text-xs text-red-600 peer-[.is-invalid]:block">
            Please enter your name.
          </p>
        </div>

        <div class="relative">
          <input
            type="email"
            id="email"
            name="email"
            placeholder="Email *"
            required
            class="peer w-full rounded-lg border border-neutral-300 px-4 py-3.5 outline-none transition focus:border-[var(--rk-red)] focus:ring-1 focus:ring-[var(--rk-red)]/20"
          />
          <p class="mt-1 hidden text-xs text-red-600 peer-[.is-invalid]:block">
            Please enter a valid email address.
          </p>
        </div>

        <div class="relative">
          <input
            type="tel"
            id="phone"
            name="phone"
            placeholder="Phone Number (10 digits) *"
            required
            class="peer w-full rounded-lg border border-neutral-300 px-4 py-3.5 outline-none transition focus:border-[var(--rk-red)] focus:ring-1 focus:ring-[var(--rk-red)]/20"
          />
          <p class="mt-1 hidden text-xs text-red-600 peer-[.is-invalid]:block">
            Please enter a valid 10-digit phone number.
          </p>
        </div>

        <div class="relative">
          <textarea
            id="message"
            name="message"
            rows="5"
            placeholder="Message *"
            required
            class="peer w-full rounded-lg border border-neutral-300 px-4 py-3.5 outline-none transition focus:border-[var(--rk-red)] focus:ring-1 focus:ring-[var(--rk-red)]/20"
          ></textarea>
          <p class="mt-1 hidden text-xs text-red-600 peer-[.is-invalid]:block">
            Please enter your message.
          </p>
        </div>

        <div id="form-status" class="hidden rounded-lg p-4 text-sm font-medium">
        </div>

        <button type="submit" id="submit-btn" class="btn-lux w-full sm:w-auto">
          <span id="btn-text">SEND YOUR MESSAGE</span>
          <span id="btn-loader" class="hidden">SENDING...</span>
        </button>
      </form>
    </div>

    <script is:inline>
      const form = document.getElementById("contact-form");
      const statusDiv = document.getElementById("form-status");
      const submitBtn = document.getElementById("submit-btn");
      const btnText = document.getElementById("btn-text");
      const btnLoader = document.getElementById("btn-loader");

      if (form) {
        form.addEventListener("submit", async (e) => {
          e.preventDefault();

          let isValid = true;
          const inputs = form.querySelectorAll(
            "input[required], textarea[required]",
          );

          // Reset states
          inputs.forEach((input) => {
            input.classList.remove("is-invalid", "border-red-500");
            input.classList.add("border-neutral-300");
          });
          statusDiv.classList.add("hidden");

          // Validate
          inputs.forEach((input) => {
            if (!input.value.trim()) {
              isValid = false;
              input.classList.add("is-invalid", "border-red-500");
              input.classList.remove("border-neutral-300");
            } else if (input.type === "email") {
              const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
              if (!emailRegex.test(input.value)) {
                isValid = false;
                input.classList.add("is-invalid", "border-red-500");
                input.classList.remove("border-neutral-300");
              }
            } else if (input.type === "tel") {
              const phoneRegex = /^[0-9]{10}$/;
              if (!phoneRegex.test(input.value)) {
                isValid = false;
                input.classList.add("is-invalid", "border-red-500");
                input.classList.remove("border-neutral-300");
              }
            }
          });

          if (!isValid) return;

          submitBtn.disabled = true;
          btnText.classList.add("hidden");
          btnLoader.classList.remove("hidden");

          if (statusDiv) statusDiv.textContent = "Sending...";
          const formData = new FormData(form);
          const payload = Object.fromEntries(formData.entries());

          try {
            const response = await fetch("/api/contact", {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                Accept: "application/json",
              },
              body: JSON.stringify(payload),
            });
            const data = await response.json().catch(() => ({}));

            if (!response.ok) {
              const message =
                data?.error || "Something went wrong. Please try again.";
              if (statusDiv) {
                statusDiv.textContent = message;
                statusDiv.className =
                  "rounded-lg p-4 text-sm font-medium bg-red-100 text-red-800";
                statusDiv.classList.remove("hidden");
              }
              return;
            }

            if (statusDiv) {
              statusDiv.textContent = "Thanks! Your message has been sent.";
              statusDiv.className =
                "rounded-lg p-4 text-sm font-medium bg-green-100 text-green-800";
              statusDiv.classList.remove("hidden");
            }
            form.reset();
          } catch (error) {
            statusDiv.textContent =
              "Something went wrong. Please try again later.";
            statusDiv.className =
              "rounded-lg p-4 text-sm font-medium bg-red-100 text-red-800";
            statusDiv.classList.remove("hidden");
          } finally {
            submitBtn.disabled = false;
            btnText.classList.remove("hidden");
            btnLoader.classList.add("hidden");
          }
        });

        // Real-time validation removal
        form.querySelectorAll("input, textarea").forEach((input) => {
          input.addEventListener("input", () => {
            input.classList.remove("is-invalid", "border-red-500");
            input.classList.add("border-neutral-300");
          });
        });
      }
    </script>

    <div
      class="reveal rounded-2xl bg-[var(--rk-dark)] p-8 text-white shadow-[0_24px_52px_-36px_rgba(0,0,0,0.55)] sm:p-10"
    >
      <div class="space-y-6">
        <div>
          <p class="text-xs uppercase tracking-[0.2em] text-neutral-400">
            Phone Number
          </p>
          <p class="mt-2 text-lg">{contactPhone}</p>
        </div>
        <div>
          <p class="text-xs uppercase tracking-[0.2em] text-neutral-400">
            Email Address
          </p>
          <p class="mt-2 text-lg">{contactEmail}</p>
        </div>
        <div>
          <p class="text-xs uppercase tracking-[0.2em] text-neutral-400">
            Head Office
          </p>
          <p
            class="mt-2 text-lg"
            set:html={headOfficeAddress?.replace(", ", ",<br />")}
          />
        </div>
        <div>
          <p class="text-xs uppercase tracking-[0.2em] text-neutral-400">
            Factory Address
          </p>
          <p
            class="mt-2 text-lg"
            set:html={manufacturingUnitAddress?.replace(", ", ",<br />")}
          />
        </div>
      </div>
    </div>
  </div>
</section>
