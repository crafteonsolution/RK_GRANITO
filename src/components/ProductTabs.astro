---
const tabs = [
  {
    label: "GVT/PGVT",
    type: "table",
    headers: ["Size", "Finish Available"],
    rows: [
      ["30x60 cm", "Glossy, Matt"],
      [
        "60x120 cm",
        "Glossy, Matt, Satin Matt, High Gloss, Sugar Finish, Carving Matt",
      ],
      ["80x80 cm", "Glossy, Matt, Satin Matt, High Gloss"],
      ["80x160 cm", "Glossy, Matt, Satin Matt, High Gloss, Carving Matt"],
      ["120x120 cm", "Glossy, Matt, Satin Matt"],
      ["100x100 cm", "Glossy, Matt, Satin Matt"],
      ["120x240 cm", "Glossy, Matt, Satin Matt, High Gloss"],
      ["20x120 cm", "Matt, Carving Matt"],
    ],
  },
  {
    label: "CERAMIC",
    type: "table",
    headers: ["Size", "Finish Available"],
    rows: [
      ["20x60 cm", "Glossy, Matt"],
      ["30x45 cm", "Glossy, Matt"],
    ],
  },
  {
    label: "ELEVATION",
    type: "table",
    headers: ["Size", "Finish Available"],
    rows: [
      ["30x45 cm", "Matt Punch"],
      ["30x60 cm", "Matt Punch"],
    ],
  },
  {
    label: "PARKING",
    type: "table",
    headers: ["Size", "Finish Available"],
    rows: [
      ["30x30 cm", "Matt, Rustic"],
      ["40x40 cm", "Matt, Rustic"],
    ],
  },
  {
    label: "SANITARY WARES",
    type: "list",
    headers: ["Product Type"],
    rows: [
      "One Piece Closet",
      "Wall Hung Closet",
      "One Piece Basin",
      "Basin with Pedestal",
      "Table Top",
      "Washbasin",
    ],
  },
  {
    label: "MOSAICS 30X30",
    type: "list",
    headers: ["Design Type"],
    rows: [
      "Hexagone",
      "Square",
      "Diamond",
      "3D Diamond",
      "Rectangular",
      "Herringbone",
      "Short Accord",
      "Chevron",
    ],
  },
];
---

<section id="product-section" class="section-shell pb-28 pt-12">
  <div class="reveal text-center mb-16">
    <p
      class="text-xs font-bold uppercase tracking-[0.4em] text-[var(--rk-red)] mb-3"
    >
      Our Collection
    </p>
    <h2 class="text-4xl font-semibold text-neutral-900 sm:text-5xl">
      Product Portfolio
    </h2>
    <div class="mx-auto mt-4 h-1 w-20 bg-[var(--rk-red)] rounded-full"></div>
  </div>

  <div
    class="reveal bg-neutral-50 rounded-[2.5rem] p-4 sm:p-8 lg:p-12 border border-neutral-200/60 shadow-xl shadow-neutral-200/40"
  >
    <div class="overflow-x-auto pb-4 scrollbar-hide">
      <div
        id="tab-buttons"
        class="flex min-w-max items-center justify-between gap-1 rounded-2xl bg-white p-1.5 shadow-sm border border-neutral-100"
      >
        {
          tabs.map((tab, idx) => (
            <button
              class:list={[
                "tab-btn relative flex-1 rounded-xl px-6 py-4 text-[10px] sm:text-xs font-bold uppercase tracking-[0.2em] transition-all duration-500",
                idx === 0
                  ? "bg-[var(--rk-dark)] text-white shadow-lg shadow-black/20"
                  : "text-neutral-500 hover:text-[var(--rk-red)] hover:bg-neutral-50",
              ]}
              data-tab-index={idx}
              type="button"
            >
              {tab.label}
            </button>
          ))
        }
      </div>
    </div>

    <div class="mt-12 overflow-hidden">
      {
        tabs.map((tab, idx) => (
          <div
            class:list={[
              "tab-panel transition-all duration-700 ease-out",
              idx === 0
                ? "block opacity-100 translate-y-0"
                : "hidden opacity-0 translate-y-8",
            ]}
            data-panel-index={idx}
          >
            {tab.type === "table" ? (
              <div class="overflow-x-auto rounded-2xl border border-neutral-200 bg-white">
                <table class="w-full text-left border-collapse">
                  <thead>
                    <tr class="bg-neutral-900 text-white">
                      {tab.headers.map((header) => (
                        <th class="px-8 py-5 text-[11px] font-bold uppercase tracking-widest border-r border-white/10 last:border-0">
                          {header}
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-neutral-100">
                    {(tab.rows as string[][]).map((row) => (
                      <tr class="group hover:bg-neutral-50 transition-colors">
                        {row.map((cell: string, cellIdx: number) => (
                          <td
                            class:list={[
                              "px-8 py-5 text-sm transition-colors",
                              cellIdx === 0
                                ? "font-bold text-neutral-900 bg-neutral-50/50 group-hover:bg-neutral-100"
                                : "text-neutral-600",
                            ]}
                          >
                            {cell}
                          </td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ) : (
              <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                {tab.rows.map((name) => (
                  <div class="group flex items-center justify-center rounded-2xl border border-neutral-200 bg-white p-6 text-center transition-all duration-300 hover:border-[var(--rk-red)] hover:shadow-xl hover:shadow-red-900/5 hover:-translate-y-1">
                    <span class="text-xs font-bold text-neutral-800 transition-colors group-hover:text-[var(--rk-red)] uppercase tracking-[0.1em]">
                      {name}
                    </span>
                  </div>
                ))}
              </div>
            )}

            <div class="mt-10 flex items-center justify-center">
              <a
                href="/contact"
                class="px-8 py-4 bg-white border border-neutral-200 rounded-full text-[10px] font-bold uppercase tracking-widest text-neutral-600 hover:bg-[var(--rk-red)] hover:text-white hover:border-transparent transition-all duration-300"
              >
                Enquire for {tab.label}
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script is:inline>
  const buttons = Array.from(document.querySelectorAll(".tab-btn"));
  const panels = Array.from(document.querySelectorAll(".tab-panel"));

  buttons.forEach((button, index) => {
    button.addEventListener("click", () => {
      // Update Buttons
      buttons.forEach((btn, i) => {
        if (i === index) {
          btn.classList.add(
            "bg-[var(--rk-dark)]",
            "text-white",
            "shadow-lg",
            "shadow-black/20",
          );
          btn.classList.remove("text-neutral-500", "hover:bg-neutral-50");
        } else {
          btn.classList.remove(
            "bg-[var(--rk-dark)]",
            "text-white",
            "shadow-lg",
            "shadow-black/20",
          );
          btn.classList.add("text-neutral-500", "hover:bg-neutral-50");
        }
      });

      // Update Panels
      panels.forEach((panel, i) => {
        if (i === index) {
          panel.classList.remove("hidden");
          setTimeout(() => {
            panel.classList.remove("opacity-0", "translate-y-8");
            panel.classList.add("opacity-100", "translate-y-0");
          }, 10);
        } else {
          panel.classList.add("hidden", "opacity-0", "translate-y-8");
          panel.classList.remove("opacity-100", "translate-y-0");
        }
      });
    });
  });
</script>
