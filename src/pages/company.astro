---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
    title="Our Company | RK Granito"
    description="Learn about RK Granito's journey, our commitment to quality, and our expansion into retail with PLLARS."
>
    <!-- Hero Section -->
    <section class="relative h-[50vh] min-h-[400px]">
        <img
            src="/images/hero/head4.jpg"
            alt="RK Granito Company"
            class="absolute inset-0 h-full w-full object-cover"
        />
        <div class="absolute inset-0 bg-black/60"></div>
        <div
            class="relative section-shell flex h-full items-center justify-center pt-20"
        >
            <div class="text-center">
                <p
                    class="text-xs font-bold uppercase tracking-[0.4em] text-[var(--rk-red)] mb-4 reveal"
                >
                    Established Since 2017
                </p>
                <h1
                    class="reveal text-4xl font-bold tracking-[0.2em] text-white sm:text-6xl md:text-7xl"
                >
                    OUR COMPANY
                </h1>
            </div>
        </div>
    </section>

    <!-- Main Content -->
    <section class="section-shell py-20 lg:py-32">
        <div class="grid gap-16 lg:grid-cols-2 lg:gap-24">
            <div class="reveal">
                <p
                    class="text-xs font-bold uppercase tracking-[0.3em] text-neutral-500 mb-4"
                >
                    About Us
                </p>
                <h2
                    class="text-3xl font-bold text-neutral-900 sm:text-5xl leading-tight"
                >
                    RK GRANITO – Building Timeless Luxury
                </h2>
                <div class="mt-6 h-1 w-20 bg-[var(--rk-red)]"></div>

                <div
                    class="mt-10 space-y-6 text-lg leading-relaxed text-neutral-600"
                >
                    <p>
                        <span class="font-bold text-neutral-900"
                            >RK GRANITO</span
                        > is a leading porcelain and ceramic tile brand, exporting
                        a comprehensive range of premium surface solutions across
                        the globe. Since the beginning of our journey <span
                            class="text-[var(--rk-red)] font-semibold"
                            >7 years ago</span
                        >, our mission has been to fulfill the dream of every
                        customer seeking beautiful, durable, and high-quality
                        surfaces for residential and commercial spaces.
                    </p>
                    <p>
                        We continuously evolve through innovative designs,
                        strict quality control systems, advanced process
                        management, and dedicated customer service. This
                        commitment has enabled us to expand our presence to <span
                            class="font-bold text-neutral-900"
                            >over 60 countries</span
                        > worldwide.
                    </p>
                    <p>
                        The name RK GRANITO reflects our promise of delivering
                        quality-assured, premium products. Customer satisfaction
                        has always been - and will always remain - at the core
                        of everything we do.
                    </p>
                </div>
            </div>

            <div class="reveal relative">
                <div
                    class="aspect-[4/5] overflow-hidden rounded-3xl shadow-2xl"
                >
                    <img
                        src="/images/hero/head5.jpg"
                        alt="Production Excellence"
                        class="h-full w-full object-cover transition-transform duration-700 hover:scale-105"
                    />
                </div>
                <div
                    class="absolute -bottom-8 -left-8 hidden md:block w-64 rounded-2xl bg-[var(--rk-dark)] p-8 text-white shadow-xl"
                >
                    <p class="text-4xl font-bold text-[var(--rk-red)]">60+</p>
                    <p
                        class="mt-2 text-xs uppercase tracking-widest text-neutral-400"
                    >
                        Countries Served Globally
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- PLLARS Retail Section -->
    <section class="bg-neutral-900 py-20 lg:py-32 text-white">
        <div class="section-shell">
            <div class="grid gap-16 lg:grid-cols-12 items-center">
                <div class="lg:col-span-7 reveal">
                    <p
                        class="text-xs font-bold uppercase tracking-[0.3em] text-[var(--rk-red)] mb-4"
                    >
                        Retail Expansion & Innovation
                    </p>
                    <h2 class="text-4xl font-bold sm:text-5xl mb-8">
                        Introducing PLLARS
                    </h2>

                    <div
                        class="space-y-6 text-lg text-neutral-300 leading-relaxed"
                    >
                        <p>
                            In addition to being one of India’s prominent
                            exporters, our group has recently expanded into the
                            retail sector with a new venture — <span
                                class="text-white font-bold">PLLARS</span
                            >.
                        </p>
                        <p>
                            PLLARS is an omni-channel retail initiative crafted
                            to deliver beautifully designed, high-quality
                            ceramic tiles and sanitaryware products to modern
                            Indian customers.
                        </p>

                        <div class="grid gap-4 mt-12 sm:grid-cols-2">
                            {
                                [
                                    "Access detailed product info",
                                    "Compare products easily",
                                    "Estimate budgets accurately",
                                    "Save time while shopping",
                                    "Make informed decisions",
                                ].map((item) => (
                                    <div class="flex items-center gap-4 bg-white/5 p-4 rounded-xl border border-white/10">
                                        <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[var(--rk-red)] text-xs text-white">
                                            ✓
                                        </span>
                                        <span class="text-sm font-medium">
                                            {item}
                                        </span>
                                    </div>
                                ))
                            }
                        </div>
                    </div>
                </div>

                <div class="lg:col-span-5 reveal mt-12 lg:mt-16">
                    <div
                        class="rounded-3xl border border-white/10 bg-white/5 p-8 backdrop-blur-sm"
                    >
                        <h3 class="text-2xl font-bold mb-6">
                            Omni-Channel Experience
                        </h3>
                        <p class="text-neutral-400 leading-relaxed mb-8">
                            Our goal is to bridge the gap between digital and
                            in-store experiences by integrating smart technology
                            tools. The first PLLARS store is located in Rajkot,
                            with plans to expand into multiple cities in the
                            near future.
                        </p>
                        <a
                            href="/contact"
                            class="btn-lux inline-block text-center w-full"
                            >Find Our Store</a
                        >
                    </div>
                </div>
            </div>
        </div>
    </section>
</MainLayout>
